# Use a unique local-only password. Keep the copied .env file out of source control.
POSTGRES_PASSWORD=replace-with-a-local-random-password

# Optional: used only when selecting Geoapify in the location-search demo.
# Keep your real key in .env (never commit it or paste it into chat).
GEOAPIFY_API_KEY=

# Optional: used only when selecting MapTiler in the location-search demo.
MAPTILER_API_KEY=

# Optional: used only when selecting LocationIQ in the location-search demo.
LOCATIONIQ_API_KEY=

# Optional: used only when selecting OpenCage in the location-search demo.
OPENCAGE_API_KEY=

# Optional: used only when selecting TomTom Places in the location-search demo.
TOMTOM_API_KEY=

# Foursquare Places demo (London); keep the real key local.
FOURSQUARE_API_KEY=
